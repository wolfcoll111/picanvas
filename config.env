# PiCanvas user configuration — edit values, then re-run ./install.sh or `docker compose up -d`
# Lines are KEY=VALUE (no spaces around =). Quoting is not required.

# --- Desktop ---------------------------------------------------------------
# Options (LinuxServer Webtop tags):
#   ubuntu-xfce  (default, balanced — Ubuntu + XFCE, best app compatibility)
#   alpine-xfce  (ultra-lightweight, ~200MB RAM — best for Pi 3 / 1GB boards)
#   arch-xfce    (bleeding-edge packages, slightly heavier than Alpine)
#   fedora-xfce  (alternative stack, similar weight to Ubuntu)
# Legacy aliases accepted by install.sh and mapped automatically:
#   xfce -> ubuntu-xfce | alpine-desktop -> alpine-xfce
DESKTOP_FLAVOR=ubuntu-xfce

# --- Networking ------------------------------------------------------------
# HTTP port for the desktop (container port 3000) and HTTPS (container 3001).
WEB_PORT=3000
CUSTOM_HTTPS_PORT=3001

# --- Locale ----------------------------------------------------------------
# PHP-style timezone string, e.g. UTC, Europe/Berlin, America/New_York.
TZ=UTC

# Browser tab title shown by the Webtop interface.
TITLE=PiCanvas

# --- Permissions -----------------------------------------------------------
# Run container processes as this UID/GID so files in ./data stay owned by you.
# 1000/1000 is the first user on Raspberry Pi OS / Debian / Ubuntu.
PUID=1000
PGID=1000

# --- Remote access (Tailscale) ---------------------------------------------
# Set to true to also start the Tailscale sidecar container (tailnet access).
USE_TAILSCALE=false
# Optional: reusable or ephemeral auth key from https://login.tailscale.com/admin/settings/keys
# If empty, you complete login manually with `docker exec picanvas-tailscale tailscale up`.
TAILSCALE_AUTHKEY=
# Hostname this device shows as on your tailnet.
TS_HOSTNAME=picanvas
# Extra flags appended to `tailscale up` inside the container (space-separated).
TS_EXTRA_ARGS=--advertise-exit-node=false
